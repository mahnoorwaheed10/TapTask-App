<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_dark"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:paddingEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/book_service"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Worker mini-info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_margin="20dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBookingWorkerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Worker Name"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvBookingWorkerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Worker Title"
                android:textColor="@color/primary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvBookingWorkerRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rate"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- Form fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                style="@style/InputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferred_date"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etBookingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/InputField"
                android:hint="e.g. 5 July 2026"
                android:focusable="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/InputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_slot"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etBookingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/InputField"
                android:hint="e.g. 10:00 AM - 12:00 PM"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/InputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/describe_issue"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etBookingDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/InputField"
                android:hint="Briefly describe what you need"
                android:minLines="3"
                android:gravity="top"
                android:layout_marginBottom="16dp"/>

            <!-- Address label -->
            <TextView
                android:id="@+id/tvBookingAddressLabel"
                style="@style/InputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_address"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etBookingAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/InputField"
                android:hint="e.g. House 12, Street 5, Tench Bhatta"
                android:minLines="2"
                android:gravity="top"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>

        <!-- Payment method selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/InputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Payment Method"
                android:layout_marginBottom="12dp"/>

            <!-- Cash on Delivery -->
            <LinearLayout
                android:id="@+id/paymentCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_payment_card_selected"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💵"
                    android:textSize="22sp"
                    android:paddingEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cash on Delivery"
                        android:textColor="@color/text_main"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pay after service"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Safepay Online Payment -->
            <LinearLayout
                android:id="@+id/paymentSafepay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_payment_card"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳"
                    android:textSize="22sp"
                    android:paddingEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Safepay"
                        android:textColor="@color/text_main"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Secure online payment"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Confirm Button -->
            <Button
                android:id="@+id/btnConfirmBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_send_request"
                style="@style/PillButton"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>