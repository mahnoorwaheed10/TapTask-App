<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top gradient header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_gradient_dark"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/welcome_back"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAuthSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/signin_subtitle"
                android:textColor="#C7D2FE"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- White card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="-20dp"
            android:padding="24dp">

            <!-- Tabs -->
            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_tabs_container"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tabSignIn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_signin"
                    android:textAlignment="center"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_tab_active"
                    android:textColor="@color/primary"/>

                <TextView
                    android:id="@+id/tabSignUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_signup"
                    android:textAlignment="center"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/muted"/>

            </LinearLayout>

            <!-- SIGN IN FORM -->
            <LinearLayout
                android:id="@+id/signInForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnGoogleSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_google"
                    style="@style/PillButton.Outline"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/or_email"
                    android:textAlignment="center"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_address"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignInEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="textEmailAddress"
                    android:hint="you@example.com"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignInPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="textPassword"
                    android:hint="••••••••"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_gravity="end"
                    android:layout_marginBottom="20dp"/>

                <!-- Role selection in Sign In -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i_am_a"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/signInRoleCustomer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/role_customer"
                        android:textAlignment="center"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:background="@drawable/bg_role_btn_active"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/signInRoleWorker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/role_worker"
                        android:textAlignment="center"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:background="@drawable/bg_role_btn_inactive"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_btn"
                    style="@style/PillButton"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_account"
                        android:textColor="@color/muted"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/linkGoToSignUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Sign Up"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- SIGN UP FORM -->
            <LinearLayout
                android:id="@+id/signUpForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/full_name"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignUpName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="textPersonName"
                    android:hint="Your full name"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_address"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignUpEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="textEmailAddress"
                    android:hint="you@example.com"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_number"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignUpPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="phone"
                    android:hint="03XX-XXXXXXX"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/city_area"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignUpCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="text"
                    android:hint="e.g. Tench Bhatta, Rawalpindi"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etSignUpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:inputType="textPassword"
                    android:hint="••••••••"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i_am_a"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/roleCustomer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/role_customer"
                        android:textAlignment="center"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:background="@drawable/bg_role_btn_active"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/roleWorker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/role_worker"
                        android:textAlignment="center"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:background="@drawable/bg_role_btn_inactive"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_account_btn"
                    style="@style/PillButton"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/have_account"
                        android:textColor="@color/muted"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/linkGoToSignIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Sign In"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>