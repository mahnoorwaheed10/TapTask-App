<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnMyBookings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="📋"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_light"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="👤"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/circle_avatar_bg"/>

            </LinearLayout>

            <!-- Hero section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_gradient_dark"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_subtitle"
                    android:textColor="#C7D2FE"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search_bar"
                    android:padding="6dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"/>

                    <TextView
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/find_now"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Area filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_by_area"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/areaFilterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/areaAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/bg_pill_selected"
                        android:textColor="@color/white"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/areaTench"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tench Bhatta"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:textColor="@color/text_main"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/areaSaddar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saddar"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:textColor="@color/text_main"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Categories section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_categories"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_subtitle"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Home Services -->
                <LinearLayout
                    android:id="@+id/catHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🏠"
                        android:textSize="26sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_light"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_home_title"
                            android:textColor="@color/text_main"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_home_desc"
                            android:textColor="@color/muted"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Shop Visit -->
                <LinearLayout
                    android:id="@+id/catShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🏪"
                        android:textSize="26sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_light"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_shop_title"
                            android:textColor="@color/text_main"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_shop_desc"
                            android:textColor="@color/muted"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Online Services -->
                <LinearLayout
                    android:id="@+id/catOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="💻"
                        android:textSize="26sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_light"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_online_title"
                            android:textColor="@color/text_main"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_online_desc"
                            android:textColor="@color/muted"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating AI Button -->
    <TextView
        android:id="@+id/btnChatbot"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="✦"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_btn_primary"
        android:elevation="8dp"/>

</FrameLayout>