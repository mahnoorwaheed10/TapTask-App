<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_dark"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:paddingEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My Worker Profile"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar + stats card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="🔨"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="@drawable/circle_avatar_bg"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:id="@+id/tvWorkerProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker Name"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvWorkerProfileSpecialization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvWorkerProfileJobs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jobs Done"
                            android:textColor="@color/muted"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvWorkerProfileRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 ⭐"
                            android:textColor="@color/amber"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rating"
                            android:textColor="@color/muted"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Editable info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <!-- Full Name -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/full_name"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="Your full name"
                    android:layout_marginBottom="16dp"/>

                <!-- Service Category -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Category"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="Enter your service category"
                    android:layout_marginBottom="16dp"/>

                <!-- Specialization -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specialization"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerSpecialization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="e.g. Certified Electrician"
                    android:layout_marginBottom="16dp"/>

                <!-- Phone -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_number"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="03XX-XXXXXXX"
                    android:inputType="phone"
                    android:layout_marginBottom="16dp"/>

                <!-- Area -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/city_area"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="Tench Bhatta, Rawalpindi"
                    android:layout_marginBottom="16dp"/>

                <!-- Experience -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerExperience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="e.g. 5 years"
                    android:layout_marginBottom="16dp"/>

                <!-- Service Rate -->
                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Rate"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWorkerRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InputField"
                    android:hint="Rs. 800/visit"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnSaveWorkerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Changes"
                style="@style/PillButton"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnWorkerLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logout"
                android:background="@drawable/bg_btn_red"
                android:textColor="@color/white"
                android:textAllCaps="false"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>