<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FC">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:background="@color/primary">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:gravity="center"/>

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✦"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_ai_avatar"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TapTask Assistant"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your 24/7 Help Partner"
                android:textSize="12sp"
                android:textColor="#E8E7FF"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- Chat Area -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/chatMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>


    <!-- Bottom Chat Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@color/white">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Ask TapTask Assistant..."
            android:textSize="14sp"
            android:background="@drawable/bg_their_bubble"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/btnSendMessage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="➤"
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_my_bubble"/>

    </LinearLayout>

</LinearLayout>