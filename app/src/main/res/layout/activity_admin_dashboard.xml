<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:background="@drawable/bg_gradient_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TapTask"
                        android:textColor="#DCD8FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Admin Dashboard"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Platform overview &amp; management"
                        android:textColor="#D8D5ED"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:background="#6658D9" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================= STATS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- ROW 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- TOTAL USERS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#EDEAFF">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTotalUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="#3F36A5"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Users"
                        android:textColor="#77738F"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- TOTAL WORKERS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#E4F7F3">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="🛠"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTotalWorkers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="#087E70"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Workers"
                        android:textColor="#77738F"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ROW 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- PENDING -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#FFF3E0">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="⏳"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPendingVerification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="#B66A00"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Verification"
                        android:textColor="#77738F"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- BOOKINGS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#E8EEFF">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="📅"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTotalBookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="#315BAA"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Bookings"
                        android:textColor="#77738F"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================= REVENUE ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#E8E5FF">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Revenue"
                    android:textColor="#716D85"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTotalRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rs. 0"
                    android:textColor="#302B62"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnStatistics"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="Statistics"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#6658D9" />

        </LinearLayout>


        <!-- ================= RECENT BOOKINGS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Bookings"
                        android:textColor="#25233A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Latest activity on TapTask"
                        android:textColor="#89869B"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnViewAllBookings"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="View All"
                    android:textColor="#5B4BD5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#E9E6FF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentActivityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp" />

        </LinearLayout>


        <!-- ================= PENDING WORKERS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Worker Verification"
                        android:textColor="#25233A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Workers waiting for approval"
                        android:textColor="#89869B"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnViewPendingWorkers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="View All"
                    android:textColor="#B66A00"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#FFF0D7" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pendingWorkersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp" />

        </LinearLayout>


        <!-- ================= QUICK MANAGEMENT ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="24dp"
            android:text="Quick Management"
            android:textColor="#25233A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="2dp"
            android:text="Manage your platform"
            android:textColor="#89869B"
            android:textSize="11sp" />


        <!-- MANAGEMENT ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnManageUsers"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="👤  Manage Users"
                android:textColor="#4B40A8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#EDEAFF" />

            <TextView
                android:id="@+id/btnManageWorkers"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="🛠  Manage Workers"
                android:textColor="#087E70"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#E4F7F3" />

        </LinearLayout>


        <!-- MANAGEMENT ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnManageBookings"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="📅  All Bookings"
                android:textColor="#315BAA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#E8EEFF" />

            <TextView
                android:id="@+id/btnManageAreas"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="📍  Manage Areas"
                android:textColor="#A34D68"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#FBE9F0" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>