<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_dark"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingEnd="16dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Payment Method Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="28dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvPaymentMethodIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳"
                    android:textSize="48sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvPaymentMethodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stripe"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvPaymentNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secure Online Payment"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_light"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp" />

                <Button
                    android:id="@+id/btnCopyNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy Number"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Payment instruction -->
            <TextView
                android:id="@+id/tvPaymentInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pay securely using Stripe. Your card details are handled securely by Stripe."
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Old screenshot/payment area -->
            <LinearLayout
                android:id="@+id/btnUploadScreenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_payment_card"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Secure payment powered by Stripe"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/ivScreenshotPreview"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Payment screenshot preview" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visa • Mastercard • Debit/Credit Cards"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Stripe payment button -->
            <Button
                android:id="@+id/btnConfirmPaymentSent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pay with Stripe"
                android:textAllCaps="false"
                style="@style/PillButton" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>