<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_dark"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:paddingEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/send_payment_to"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Payment method icon + name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvPaymentMethodIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="40sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvPaymentMethodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EasyPaisa"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvPaymentNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0300-1234567"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_light"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/btnCopyNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_number"
                    style="@style/PillButton.Outline"
                    android:gravity="center"
                    android:padding="12dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPaymentInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send the exact amount to the number above using your EasyPaisa app, then upload a screenshot as proof."
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Upload screenshot -->
            <LinearLayout
                android:id="@+id/btnUploadScreenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_payment_card"
                android:padding="24dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_screenshot"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/ivScreenshotPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnConfirmPaymentSent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ive_sent_payment"
                style="@style/PillButton"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>